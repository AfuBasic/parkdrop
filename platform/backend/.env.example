APP_NAME=ParkDrop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.parkdrop.com.ng
FRONTEND_URL=https://app.parkdrop.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkdrop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.parkdrop.com.ng
SANCTUM_STATEFUL_DOMAINS=app.parkdrop.com.ng

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST="smtp.zeptomail.com"
MAIL_PORT=587
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@parkdrop.com.ng"
MAIL_FROM_NAME="ParkDrop"

# ParkDrop Specific Configuration
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMS_PROVIDER=
SMS_API_KEY=
INITIAL_SMS_CREDITS=20

# Reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="ws.parkdrop.com.ng"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
