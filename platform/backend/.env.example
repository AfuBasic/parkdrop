# ==========================================
# ParkDrop Production Environment Template
# ==========================================

# --- APP CONFIGURATION ---
APP_NAME=ParkDrop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.parkdrop.com.ng
APP_VERSION=1.0.0
FRONTEND_URL=https://app.parkdrop.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- LOGGING & OBSERVABILITY ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# --- DATABASE (MYSQL 8.4) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkdrop
DB_USERNAME=parkdrop_app
DB_PASSWORD=

# --- SESSIONS & SANCTUM ---
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.parkdrop.com.ng
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.parkdrop.com.ng,parkdrop.com.ng

# --- CACHE & REDIS ---
CACHE_STORE=redis
CACHE_PREFIX=pd_cache:
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- QUEUES & HORIZON ---
QUEUE_CONNECTION=redis
HORIZON_PREFIX=parkdrop_horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# --- WEBSOCKETS & REVERB ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="ws.parkdrop.com.ng"
REVERB_PORT=443
REVERB_SCHEME=https

# --- FILE STORAGE ---
FILESYSTEM_DISK=local

# --- MAIL (ZEPTOMAIL / SMTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST="smtp.zeptomail.com"
MAIL_PORT=587
MAIL_USERNAME=emailapikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@parkdrop.com.ng"
MAIL_FROM_NAME="ParkDrop"

# --- CLOUDINARY (PACKAGE MEDIA) ---
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMS SERVICE (TERMII) ---
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID="OE Alert"
TERMII_BASE_URL=https://api.ng.termii.com/api
# Secret for verifying HMAC signatures on Termii delivery status webhooks.
# Obtain from the Termii dashboard → Webhooks → Signing Secret.
TERMII_WEBHOOK_SECRET=
INITIAL_SMS_CREDITS=20

# --- PAYMENT PROVIDER (FLUTTERWAVE / PAYSTACK) ---
PAYMENT_PROVIDER=flutterwave
PAYMENT_CURRENCY=NGN
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3

# --- AUTH & OTP SECURITY POLICIES ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_SEND_COOLDOWN_SECONDS=60
OTP_SEND_SHORT_WINDOW_ATTEMPTS=3
OTP_SEND_SHORT_WINDOW_MINUTES=15
OTP_SEND_DAILY_ATTEMPTS=8
OTP_IP_ATTEMPTS=20
OTP_IP_MINUTES=15
OTP_GLOBAL_DAILY_ATTEMPTS=1000
OTP_QUEUE=auth


